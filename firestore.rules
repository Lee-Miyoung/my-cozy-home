rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(pid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/familyProjects/$(pid)) &&
        (
          get(/databases/$(database)/documents/familyProjects/$(pid)).data.ownerUid == request.auth.uid ||
          (request.auth.token.email_verified == true &&
            request.auth.token.email in get(/databases/$(database)/documents/familyProjects/$(pid)).data.memberEmails)
        );
    }
    function owner(pid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/familyProjects/$(pid)) &&
        get(/databases/$(database)/documents/familyProjects/$(pid)).data.ownerUid == request.auth.uid;
    }
    match /familyProjects/{pid} {
      allow get: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.token.email_verified == true &&
          request.auth.token.email in resource.data.memberEmails));
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberEmails == [] &&
        request.resource.data.keys().hasOnly(['ownerUid','title','stage','memberEmails','createdAt','updatedAt']) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 120;
      allow update: if owner(pid) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.keys().hasOnly(['ownerUid','title','stage','memberEmails','createdAt','updatedAt']) &&
        request.resource.data.memberEmails is list &&
        request.resource.data.memberEmails.size() <= 10 &&
        request.resource.data.stage is string && request.resource.data.stage.size() <= 100 &&
        request.resource.data.title is string && request.resource.data.title.size() <= 120;
      allow delete: if owner(pid);
      match /entries/{eid} {
        allow read: if member(pid);
        allow create: if member(pid) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['authorUid','authorName','date','stage','note','photoPaths','createdAt','updatedAt']) &&
          request.resource.data.note is string && request.resource.data.note.size() <= 1200 &&
          request.resource.data.stage is string && request.resource.data.stage.size() <= 60 &&
          request.resource.data.photoPaths is list && request.resource.data.photoPaths.size() <= 8;
        allow update: if member(pid) &&
          (request.auth.uid == resource.data.authorUid || owner(pid)) &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.photoPaths == resource.data.photoPaths &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note','stage','updatedAt']) &&
          request.resource.data.note is string && request.resource.data.note.size() <= 1200;
        allow delete: if member(pid) && (request.auth.uid == resource.data.authorUid || owner(pid));
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
